# Copy to server/.env.test for local Lab 2 tests; never commit that copy.
# The database name must end with _test. Playwright uses only an allowlisted E2E schema.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/toktickit_lab2_test?schema=public"
ATTACHMENT_STORAGE_DIR="./.test-attachments"
PORT=
CLIENT_ORIGIN="http://localhost:5173"
# Lab 3 seed values are local-only and must never be committed.
LAB3_REQUESTER_INITIAL_PASSWORD="set-a-local-12-character-password"
LAB3_IT_STAFF_INITIAL_PASSWORD="set-a-local-12-character-password"
LAB3_ADMIN_INITIAL_PASSWORD="set-a-local-12-character-password"
